<template>
  <div class="container">
    <!-- ЭКРАН 1: СТИЛЬНЫЙ СПИСОК ЗАМЕТОК (Apple Style) -->
    <div class="page" if="{{!isEditing}}">
      <div class="header-row">
        <text class="title">Заметки</text>
        <text class="count-badge">{{notes.length}}</text>
      </div>
      
      <list class="notes-list">
        <block for="{{(index, item) in notes}}">
          <list-item type="note" class="note-card" onclick="deleteNote(index)">
            <div class="card-decorator"></div>
            <div class="card-content">
              <text class="note-text">{{item}}</text>
              <text class="note-date">Заметка #{{index + 1}} • Удалить ✕</text>
            </div>
          </list-item>
        </block>
      </list>
      
      <div class="action-bar">
        <input type="button" class="btn-primary" value="+ Новая запись" onclick="startEdit" />
      </div>
    </div>

    <!-- ЭКРАН 2: ИНТЕРФЕЙС ВВОДА И КЛАВИАТУРА НА ПОЛ-ЭКРАНА -->
    <div class="page" if="{{isEditing}}">
      <!-- Поле предпросмотра текста -->
      <div class="input-preview-box">
        <text class="preview-text">{{currentText || 'Начните вводить текст...'}}</text>
        <div class="cursor" if="{{currentText.length > 0}}"></div>
      </div>

      <!-- ПОЛНОЦЕННЫЙ БЛОК КЛАВИАТУРЫ (Занимает нижнюю половину экрана) -->
      <div class="keyboard-viewport">
        <!-- Двухрядная прокручиваемая лента крупных букв -->
        <div class="keyboard-scroll-zone">
          <block for="{{pair in keyboardPairs}}">
            <div class="kbd-column">
              <input type="button" class="key-cell" value="{{pair.top}}" onclick="addChar(pair.top)" />
              <input type="button" class="key-cell" value="{{pair.bottom}}" onclick="addChar(pair.bottom)" />
            </div>
          </block>
        </div>

        <!-- Нижняя панель управления: Пробел и Системные клавиши -->
        <div class="keyboard-system-row">
          <input type="button" class="sys-btn btn-backspace" value="⌫" onclick="backspace" />
          <input type="button" class="sys-btn btn-spacebar" value="П Р О Б Е Л" onclick="addChar(' ')" />
          <input type="button" class="sys-btn btn-submit" value="⏎" onclick="saveNote" />
        </div>
      </div>

      <!-- Кнопка Отмены (сверху или снизу экрана) -->
      <input type="button" class="btn-secondary" value="Отмена" onclick="cancelEdit" />
    </div>
  </div>
</template>

<script>
import storage from '@system.storage'
import vibrator from '@system.vibrator'

export default {
  private: {
    notes: [],
    isEditing: false,
    currentText: '',
    // Буквы разбиты на пары (верхняя/нижняя) для создания красивой двухрядной сетки
    keyboardPairs: [
      {top: 'А', bottom: 'а'}, {top: 'Б', bottom: 'б'}, {top: 'В', bottom: 'в'},
      {top: 'Г', bottom: 'г'}, {top: 'Д', bottom: 'д'}, {top: 'Е', bottom: 'е'},
      {top: 'Ё', bottom: 'ё'}, {top: 'Ж', bottom: 'ж'}, {top: 'З', bottom: 'з'},
      {top: 'И', bottom: 'и'}, {top: 'Й', bottom: 'й'}, {top: 'К', bottom: 'к'},
      {top: 'Л', bottom: 'л'}, {top: 'М', bottom: 'м'}, {top: 'Н', bottom: 'н'},
      {top: 'О', bottom: 'о'}, {top: 'П', bottom: 'п'}, {top: 'Р', bottom: 'р'},
      {top: 'С', bottom: 'с'}, {top: 'Т', bottom: 'т'}, {top: 'У', bottom: 'у'},
      {top: 'Ф', bottom: 'ф'}, {top: 'Х', bottom: 'х'}, {top: 'Ц', bottom: 'ц'},
      {top: 'Ч', bottom: 'ч'}, {top: 'Ш', bottom: 'ш'}, {top: 'Щ', bottom: 'щ'},
      {top: 'Ъ', bottom: 'ъ'}, {top: 'Ы', bottom: 'ы'}, {top: 'Ь', bottom: 'ь'},
      {top: 'Э', bottom: 'э'}, {top: 'Ю', bottom: 'ю'}, {top: 'Я', bottom: 'я'},
      {top: '1', bottom: '.'}, {top: '2', bottom: ','}, {top: '3', bottom: '?'},
      {top: '4', bottom: '!'}, {top: '5', bottom: '-'}, {top: '6', bottom: '+'},
      {top: '7', bottom: '='}, {top: '8', bottom: ':'}, {top: '9', bottom: '('},
      {top: '0', bottom: ')'}
    ]
  },

  onInit() {
    this.loadNotes();
  },

  loadNotes() {
    const self = this;
    storage.get({
      key: 'secure_notes_data',
      default: '[]',
      success: function(data) {
        if (data) {
          try {
            self.notes = JSON.parse(data);
          } catch (e) {
            self.notes = [];
          }
        }
      },
      fail: function() {
        self.notes = [];
      }
    });
  },

  persistData() {
    storage.set({
      key: 'secure_notes_data',
      value: JSON.stringify(this.notes)
    });
  },

  startEdit() {
    this.vibrate('short');
    this.currentText = '';
    this.isEditing = true;
  },

  cancelEdit() {
    this.vibrate('short');
    this.isEditing = false;
  },

  addChar(char) {
    this.vibrate('short');
    this.currentText += char;
  },

  backspace() {
    this.vibrate('short');
    if (this.currentText.length > 0) {
      this.currentText = this.currentText.slice(0, -1);
    }
  },

  saveNote() {
    if (this.currentText.trim() !== '') {
      this.notes.push(this.currentText);
      this.persistData();
      this.vibrate('long');
    }
    this.isEditing = false;
  },

  deleteNote(index) {
    this.notes.splice(index, 1);
    this.persistData();
    this.vibrate('long');
  },

  vibrate(mode) {
    try {
      vibrator.vibrate({ mode: mode });
    } catch(e) {}
  }
}
</script>

<style>
  /* ПРЕМИАЛЬНЫЕ СТИЛИ ИНТЕРФЕЙСА (Mi Band 10: 212px x 520px) */
  .container {
    flex-direction: column;
    background-color: #000000;
    width: 212px;
    height: 520px;
    align-items: center;
  }
  .page {
    flex-direction: column;
    width: 212px;
    height: 520px;
    padding: 16px 8px;
    align-items: center;
  }
  
  /* Хедер списка */
  .header-row {
    flex-direction: row;
    width: 196px;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding: 0 4px;
  }
  .title {
    color: #ffffff;
    font-size: 26px;
    font-weight: bold;
  }
  .count-badge {
    background-color: #ff9f0a;
    color: #000000;
    font-size: 14px;
    font-weight: bold;
    padding: 2px 8px;
    border-radius: 10px;
  }

  /* Красивые карточки заметок */
  .notes-list {
    width: 196px;
    height: 370px;
    flex-direction: column;
  }
  .note-card {
    background-color: #1c1c1e;
    border-radius: 12px;
    margin-bottom: 10px;
    width: 196px;
    flex-direction: row;
    overflow: hidden;
  }
  .card-decorator {
    width: 5px;
    height: 70px;
    background-color: #ff9f0a;
  }
  .card-content {
    flex-direction: column;
    padding: 10px 12px;
    width: 191px;
  }
  .note-text {
    color: #ffffff;
    font-size: 17px;
    font-weight: 500;
  }
  .note-date {
    color: #8e8e93;
    font-size: 12px;
    margin-top: 4px;
  }

  /* Кнопки действий */
  .action-bar {
    width: 196px;
    height: 50px;
    justify-content: center;
    margin-top: 6px;
  }
  .btn-primary {
    width: 196px;
    height: 44px;
    background-color: #ff9f0a;
    color: #000000;
    border-radius: 22px;
    font-size: 16px;
    font-weight: bold;
  }
  .btn-secondary {
    width: 196px;
    height: 34px;
    background-color: #2c2c2e;
    color: #ff453a;
    border-radius: 17px;
    font-size: 14px;
    margin-top: 8px;
  }

  /* Окно предпросмотра текста */
  .input-preview-box {
    width: 196px;
    height: 140px;
    background-color: #1c1c1e;
    border-radius: 14px;
    padding: 10px;
    margin-bottom: 10px;
    border: 1px solid #2c2c2e;
    flex-direction: row;
  }
  .preview-text {
    color: #ffffff;
    font-size: 16px;
    width: 180px;
  }

  /* КЛАВИАТУРА НА ПОЛ-ЭКРАНА */
  .keyboard-viewport {
    width: 196px;
    height: 250px;
    background-color: #1c1c1e;
    border-radius: 16px;
    padding: 6px;
    flex-direction: column;
    border: 1px solid #2c2c2e;
  }
  .keyboard-scroll-zone {
    width: 184px;
    height: 175px;
    flex-direction: row;
    overflow: scroll;
    scroll-x: true;
  }
  .kbd-column {
    flex-direction: column;
    width: 50px;
    height: 170px;
    margin-right: 6px;
    justify-content: space-between;
  }
  .key-cell {
    width: 50px;
    height: 80px;
    background-color: #2c2c2e;
    color: #ffffff;
    border-radius: 10px;
    font-size: 22px;
    font-weight: 500;
    flex-shrink: 0;
  }

  /* Системный ряд: Пробел, Бэкспейс, Энтер */
  .keyboard-system-row {
    flex-direction: row;
    width: 184px;
    height: 55px;
    margin-top: 6px;
    justify-content: space-between;
  }
  .sys-btn {
    color: #ffffff;
    border-radius: 10px;
    font-size: 18px;
    font-weight: bold;
  }
  .btn-spacebar {
    width: 90px;
    height: 50px;
    background-color: #3a3a3c;
    font-size: 11px;
    color: #8e8e93;
  }
  .btn-backspace {
    width: 44px;
    height: 50px;
    background-color: #ff453a;
  }
  .btn-submit {
    width: 44px;
    height: 50px;
    background-color: #30d158;
    color: #000000;
  }
</style>
