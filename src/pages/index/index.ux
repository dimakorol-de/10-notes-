<template>
  <div class="container">
    <!-- ЭКРАН 1: СТИЛЬНЫЙ МИНИМАЛИСТИЧНЫЙ СПИСОК ЗАМЕТОК -->
    <div class="page" if="{{!isEditing}}">
      <div class="header-row">
        <text class="title">Заметки</text>
        <text class="count-badge" if="{{notes.length > 0}}">{{notes.length}}</text>
      </div>
      
      <!-- ЦЕНТРАЛЬНЫЙ КОНТУРНЫЙ ПЛЮС (Скрывается, когда есть заметки) -->
      <div class="empty-state" if="{{notes.length === 0}}" onclick="startEdit">
        <div class="center-plus-box">
          <text class="center-plus-icon">+</text>
        </div>
        <text class="empty-text">Нажмите, чтобы добавить</text>
      </div>

      <!-- СПИСОК ЗАМЕТОК С КОНТУРНЫМ УДАЛЕНИЕМ -->
      <list class="notes-list" if="{{notes.length > 0}}">
        <block for="{{(index, item) in notes}}">
          <list-item type="note" class="note-card">
            <div class="card-body">
              <text class="note-text">{{item}}</text>
            </div>
            <div class="delete-btn-box" onclick="deleteNote(index)">
              <text class="delete-icon">✕</text>
            </div>
          </list-item>
        </block>
      </list>
      
      <!-- Контурная кнопка добавления внизу -->
      <div class="action-bar" if="{{notes.length > 0}}">
        <input type="button" class="btn-outline-add" value="+ Добавить запись" onclick="startEdit" />
      </div>
    </div>

    <!-- ЭКРАН 2: НИЗКАЯ КЛАВИАТУРА ЙЦУКЕН -->
    <div class="page" if="{{isEditing}}">
      <div class="input-preview-box">
        <text class="preview-text">{{currentText || 'Введите текст заметки...'}}</text>
      </div>

      <!-- НИЗКАЯ КОНТУРНАЯ КЛАВИАТУРА НА ПОЛ-ЭКРАНА -->
      <div class="keyboard-viewport">
        <div class="keyboard-scroll-zone">
          <div class="qwerty-board">
            <!-- Ряд 1 -->
            <div class="kbd-row">
              <block for="{{char in row1}}">
                <input type="button" class="key-cell-outline" value="{{char}}" onclick="addChar(char)" />
              </block>
            </div>
            <!-- Ряд 2 -->
            <div class="kbd-row-center">
              <block for="{{char in row2}}">
                <input type="button" class="key-cell-outline" value="{{char}}" onclick="addChar(char)" />
              </block>
            </div>
            <!-- Ряд 3 -->
            <div class="kbd-row-bottom">
              <block for="{{char in row3}}">
                <input type="button" class="key-cell-outline" value="{{char}}" onclick="addChar(char)" />
              </block>
            </div>
          </div>
        </div>

        <!-- СИСТЕМНЫЙ СТРОГИЙ РЯД -->
        <div class="keyboard-system-row">
          <input type="button" class="sys-btn-outline btn-backspace" value="⌫" onclick="backspace" />
          <input type="button" class="sys-btn-outline btn-spacebar" value="ПРОБЕЛ" onclick="addChar(' ')" />
          <input type="button" class="sys-btn-outline btn-submit" value="ГОТОВО" onclick="saveNote" />
        </div>
      </div>

      <input type="button" class="btn-outline-cancel" value="ОТМЕНА" onclick="cancelEdit" />
    </div>
  </div>
</template>

<script>
import storage from '@system.storage'
import vibrator from '@system.vibrator'

export default {
  private: {
    notes: [],
    isEditing: false,
    currentText: '',
    row1: ['Й','Ц','У','К','Е','Н','Г','Ш','Щ','З','Х','Ъ','1','2','3','4','5'],
    row2: ['Ф','Ы','В','А','П','Р','О','Л','Д','Ж','Э',',','.','6','7','8','9'],
    row3: ['Я','Ч','С','М','И','Т','Ь','Б','Ю','?','!','-',':','+','=','0']
  },

  onInit() {
    this.loadNotes();
  },

  loadNotes() {
    const self = this;
    storage.get({
      key: 'sol_premium_notes_fixed',
      success: function(data) {
        if (data && data.trim() !== '') {
          try {
            // Разворачиваем строку и форсируем обновление интерфейса
            self.notes = JSON.parse(data);
          } catch (e) {
            self.notes = [];
          }
        }
      }
    });
  },

  startEdit() {
    this.vibrate('short');
    this.currentText = '';
    this.isEditing = true;
  },

  cancelEdit() {
    this.vibrate('short');
    this.isEditing = false;
  },

  addChar(char) {
    this.vibrate('short');
    this.currentText += char;
  },

  backspace() {
    this.vibrate('short');
    if (this.currentText.length > 0) {
      this.currentText = this.currentText.slice(0, -1);
    }
  },

  // ИСПРАВЛЕННЫЙ МЕТОД: Добавлена перепривязка массива для мгновенного отображения карточки
  saveNote() {
    const self = this;
    if (self.currentText.trim() !== '') {
      self.vibrate('long');
      
      // Добавляем новый текст в массив
      self.notes.push(self.currentText);
      
      // ХИТРОСТЬ: Клонируем массив, чтобы интерфейс Mi Band увидел изменения и сразу вывел карточку на экран
      self.notes = [...self.notes];
      
      // Записываем строковое значение в память чипа
      storage.set({
        key: 'sol_premium_notes_fixed',
        value: JSON.stringify(self.notes),
        success: function() {
          self.isEditing = false;
        },
        fail: function() {
          self.isEditing = false;
        }
      });
    } else {
      self.isEditing = false;
    }
  },

  deleteNote(index) {
    const self = this;
    self.vibrate('long');
    
    // Удаляем элемент и форсируем обновление экрана через деструктуризацию
    self.notes.splice(index, 1);
    self.notes = [...self.notes];
    
    storage.set({
      key: 'sol_premium_notes_fixed',
      value: JSON.stringify(self.notes)
    });
  },

  vibrate(mode) {
    try {
      vibrator.vibrate({ mode: mode });
    } catch(e) {}
  }
}
</script>

<style>
  /* Стили остаются премиальными и контурными */
  .container { flex-direction: column; background-color: #000000; width: 212px; height: 520px; align-items: center; }
  .page { flex-direction: column; width: 212px; height: 520px; padding: 16px 8px; align-items: center; }
  .header-row { flex-direction: row; width: 196px; justify-content: space-between; align-items: center; margin-bottom: 16px; padding: 0 4px; }
  .title { color: #ffffff; font-size: 24px; font-weight: bold; }
  .count-badge { border: 1px solid #ffffff; color: #ffffff; font-size: 12px; padding: 1px 8px; border-radius: 6px; }
  .empty-state { flex-direction: column; align-items: center; justify-content: center; width: 196px; height: 380px; margin-top: -10px; }
  .center-plus-box { width: 80px; height: 80px; border: 1px dashed #ffffff; border-radius: 40px; align-items: center; justify-content: center; margin-bottom: 14px; }
  .center-plus-icon { color: #ffffff; font-size: 42px; font-weight: 300; }
  .empty-text { color: #8e8e93; font-size: 14px; text-align: center; }
  .notes-list { width: 196px; height: 360px; flex-direction: column; }
  .note-card { border: 1px solid #2c2c2e; border-radius: 12px; margin-bottom: 10px; width: 196px; flex-direction: row; align-items: center; justify-content: space-between; }
  .card-body { padding: 14px 12px; width: 150px; }
  .note-text { color: #ffffff; font-size: 18px; }
  .delete-btn-box { width: 44px; height: 50px; align-items: center; justify-content: center; border-left: 1px solid #2c2c2e; }
  .delete-icon { color: #ff453a; font-size: 16px; }
  .action-bar { width: 196px; height: 46px; margin-top: 12px; }
  .btn-outline-add { width: 196px; height: 44px; background-color: transparent; border: 1px solid #ffffff; color: #ffffff; border-radius: 10px; font-size: 15px; font-weight: bold; }
  .btn-outline-cancel { width: 196px; height: 38px; background-color: transparent; border: 1px solid #ff453a; color: #ff453a; border-radius: 8px; font-size: 14px; margin-top: 10px; }
  .input-preview-box { width: 196px; height: 110px; border: 1px solid #2c2c2e; border-radius: 12px; padding: 12px; margin-bottom: 14px; }
  .preview-text { color: #ffffff; font-size: 20px; }
  .keyboard-viewport { width: 196px; height: 290px; border: 1px solid #2c2c2e; border-radius: 16px; padding: 6px; flex-direction: column; background-color: #000000; }
  .keyboard-scroll-zone { width: 184px; height: 215px; flex-direction: row; overflow: scroll; scroll-x: true; }
  .qwerty-board { flex-direction: column; width: 760px; height: 205px; justify-content: space-between; }
  .kbd-row { flex-direction: row; width: 760px; }
  .kbd-row-center { flex-direction: row; width: 760px; padding-left: 12px; }
  .kbd-row-bottom { flex-direction: row; width: 760px; padding-left: 24px; }
  .key-cell-outline { width: 40px; height: 62px; background-color: transparent; border: 1px solid #48484a; color: #ffffff; margin-right: 4px; border-radius: 8px; font-size: 22px; font-weight: bold; flex-shrink: 0; }
  .keyboard-system-row { flex-direction: row; width: 184px; height: 52px; margin-top: 8px; justify-content: space-between; }
  .sys-btn-outline { color: #ffffff; background-color: transparent; border-radius: 8px; font-weight: bold; font-size: 14px; }
  .btn-spacebar { width: 90px; height: 46px; border: 1px solid #ffffff; font-size: 12px; }
  .btn-backspace { width: 42px; height: 46px; border: 1px solid #ff453a; color: #ff453a; font-size: 16px; }
  .btn-submit { width: 44px; height: 46px; border: 1px solid #30d158; color: #30d158; }
</style>
