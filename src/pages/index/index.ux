<template>
  <div class="container">
    <!-- ЭКРАН 1: Список заметок -->
    <div class="page" if="{{!isEditing}}">
      <text class="title">Заметки</text>
      <list class="notes-list">
        <block for="{{(index, item) in notes}}">
          <list-item type="note" class="note-item">
            <text class="note-text" onclick="deleteNote(index)">{{item}}</text>
          </list-item>
        </block>
      </list>
      <input type="button" class="btn-add" value="+ Новая" onclick="startEdit" />
    </div>

    <!-- ЭКРАН 2: Ввод текста (Клавиатура) -->
    <div class="page" if="{{isEditing}}">
      <div class="input-preview">
        <text class="preview-text">{{currentText || 'Начните ввод...'}}</text>
      </div>

      <!-- Прокручиваемая русская лента букв -->
      <tabs class="keyboard-scroll" index="0">
        <tab-content class="kbd-container">
          <div class="kbd-row">
            <block for="{{char in keyboardChars}}">
              <input type="button" class="key-btn" value="{{char}}" onclick="addChar(char)" />
            </block>
          </div>
        </tab-content>
      </tabs>

      <!-- Управляющие кнопки -->
      <div class="controls-row">
        <input type="button" class="control-btn btn-back" value="⌫" onclick="backspace" />
        <input type="button" class="control-btn btn-save" value="OK" onclick="saveNote" />
        <input type="button" class="control-btn btn-cancel" value="X" onclick="cancelEdit" />
      </div>
    </div>
  </div>
</template>

<script>
import storage from '@system.storage'
import vibrator from '@system.vibrator'

export default {
  private: {
    notes: [],
    isEditing: false,
    currentText: '',
    // Исключительно русская клавиатура-лента
    keyboardChars: [
      'А','Б','В','Г','Д','Е','Ё','Ж','З','И','Й','К','Л','М','Н','О','П','Р','С','Т','У','Ф','Х','Ц','Ч','Ш','Щ','Ъ','Ы','Ь','Э','Ю','Я',
      'а','б','в','г','д','е','ё','ж','з','и','й','к','л','м','н','о','п','р','с','т','у','ф','х','ц','ч','ш','щ','ъ','ы','ь','э','ю','я',
      '1','2','3','4','5','6','7','8','9','0','.',',','?','!','-','+','=',')','(',' '
    ]
  },

  onInit() {
    this.loadNotes();
  },

  loadNotes() {
    const self = this;
    storage.get({
      key: 'user_notes',
      default: '[]',
      success: function(data) {
        try {
          self.notes = JSON.parse(data);
        } catch(e) {
          self.notes = [];
        }
      }
    });
  },

  saveNotesToStorage() {
    storage.set({
      key: 'user_notes',
      value: JSON.stringify(this.notes)
    });
  },

  startEdit() {
    this.vibrate('short');
    this.currentText = '';
    this.isEditing = true;
  },

  cancelEdit() {
    this.isEditing = false;
  },

  addChar(char) {
    this.vibrate('short');
    this.currentText += char;
  },

  backspace() {
    this.vibrate('short');
    if (this.currentText.length > 0) {
      this.currentText = this.currentText.slice(0, -1);
    }
  },

  saveNote() {
    this.vibrate('long');
    if (this.currentText.trim() !== '') {
      this.notes.push(this.currentText);
      this.saveNotesToStorage();
    }
    this.isEditing = false;
  },

  deleteNote(index) {
    this.vibrate('long');
    this.notes.splice(index, 1);
    this.saveNotesToStorage();
  },

  vibrate(mode) {
    try {
      vibrator.vibrate({ mode: mode });
    } catch(e) {}
  }
}
</script>

<style>
  /* Стили остаются прежними для идеального отображения на экране 212x520 */
  .container { flex-direction: column; background-color: #000000; width: 212px; height: 520px; align-items: center; }
  .page { flex-direction: column; width: 212px; height: 520px; padding: 20px 10px; align-items: center; }
  .title { color: #ffffff; font-size: 24px; margin-bottom: 15px; font-weight: bold; }
  .notes-list { width: 190px; height: 380px; flex-direction: column; }
  .note-item { background-color: #1c1c1e; border-radius: 10px; padding: 12px; margin-bottom: 8px; width: 190px; }
  .note-text { color: #ffffff; font-size: 18px; }
  .btn-add { width: 180px; height: 45px; background-color: #30d158; color: #ffffff; border-radius: 20px; font-size: 18px; margin-top: 10px; }
  .input-preview { width: 192px; height: 120px; background-color: #1c1c1e; border-radius: 10px; padding: 8px; margin-bottom: 15px; }
  .preview-text { color: #ffffff; font-size: 18px; }
  .keyboard-scroll { width: 192px; height: 80px; background-color: #2c2c2e; border-radius: 10px; margin-bottom: 15px; }
  .kbd-container { width: 2400px; height: 80px; }
  .kbd-row { flex-direction: row; height: 80px; align-items: center; padding: 0px 10px; }
  .key-btn { width: 45px; height: 60px; background-color: #3a3a3c; color: #ffffff; margin-right: 6px; border-radius: 6px; font-size: 22px; }
  .controls-row { flex-direction: row; width: 192px; justify-content: space-between; }
  .control-btn { width: 58px; height: 45px; color: #ffffff; border-radius: 10px; font-size: 18px; }
  .btn-back { background-color: #ff453a; }
  .btn-save { background-color: #30d158; }
  .btn-cancel { background-color: #8e8e93; }
</style> 
