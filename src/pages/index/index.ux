<template>
  <div class="container">
    <!-- ЭКРАН 1: СТРОГИЙ СПИСОК ЗАМЕТОК -->
    <div class="page" if="{{!isEditing}}">
      <div class="header-row">
        <text class="title">Заметки</text>
        <text class="count-badge">{{notes.length}}</text>
      </div>
      
      <list class="notes-list">
        <block for="{{(index, item) in notes}}">
          <list-item type="note" class="note-card" onclick="deleteNote(index)">
            <text class="note-text">{{item}}</text>
          </list-item>
        </block>
      </list>
      
      <div class="action-bar">
        <input type="button" class="btn-primary" value="НОВАЯ ЗАМЕТКА" onclick="startEdit" />
      </div>
    </div>

    <!-- ЭКРАН 2: ПОЛНОЦЕННАЯ ТЕЛЕФОННАЯ КЛАВИАТУРА ЙЦУКЕН С МОТКОЙ -->
    <div class="page" if="{{isEditing}}">
      <!-- Поле вывода текста -->
      <div class="input-preview-box">
        <text class="preview-text">{{currentText || 'Ввод текста...'}}</text>
      </div>

      <!-- КЛАВИАТУРНЫЙ БЛОК НА ПОЛ-ЭКРАНА -->
      <div class="keyboard-viewport">
        
        <!-- МОНОЛИТНАЯ ТЕЛЕФОННАЯ ПЛАТА ЙЦУКЕН (Плавная горизонтальная мотка) -->
        <div class="keyboard-scroll-zone">
          <div class="qwerty-board">
            
            <!-- Ряд 1: ЙЦУКЕН... -->
            <div class="kbd-row">
              <block for="{{char in row1}}">
                <input type="button" class="key-cell" value="{{char}}" onclick="addChar(char)" />
              </block>
            </div>
            
            <!-- Ряд 2: ФЫВАП... -->
            <div class="kbd-row-center">
              <block for="{{char in row2}}">
                <input type="button" class="key-cell" value="{{char}}" onclick="addChar(char)" />
              </block>
            </div>
            
            <!-- Ряд 3: ЯЧСМИТ... -->
            <div class="kbd-row-bottom">
              <block for="{{char in row3}}">
                <input type="button" class="key-cell" value="{{char}}" onclick="addChar(char)" />
              </block>
            </div>

          </div>
        </div>

        <!-- СИСТЕМНАЯ НИЖНЯЯ ПАНЕЛЬ (Всегда на месте) -->
        <div class="keyboard-system-row">
          <input type="button" class="sys-btn btn-backspace" value="⌫" onclick="backspace" />
          <input type="button" class="sys-btn btn-spacebar" value="ПРОБЕЛ" onclick="addChar(' ')" />
          <input type="button" class="sys-btn btn-submit" value="ГОТОВО" onclick="saveNote" />
        </div>
      </div>

      <input type="button" class="btn-secondary" value="ОТМЕНА" onclick="cancelEdit" />
    </div>
  </div>
</template>

<script>
import storage from '@system.storage'
import vibrator from '@system.vibrator'

export default {
  private: {
    notes: [],
    isEditing: false,
    currentText: '',
    // Полноценная телефонная раскладка по рядам (ЙЦУКЕН)
    row1: ['Й','Ц','У','К','Е','Н','Г','Ш','Щ','З','Х','Ъ','1','2','3','4','5'],
    row2: ['Ф','Ы','В','А','П','Р','О','Л','Д','Ж','Э',',','.','6','7','8','9'],
    row3: ['Я','Ч','С','М','И','Т','Ь','Б','Ю','?','!','-',':','+','=','0']
  },

  onInit() {
    this.loadNotes();
  },

  loadNotes() {
    const self = this;
    storage.get({
      key: 'premium_sol_store',
      default: '[]',
      success: function(data) {
        if (data) {
          try { self.notes = JSON.parse(data); } catch (e) { self.notes = []; }
        }
      }
    });
  },

  persistData() {
    storage.set({
      key: 'premium_sol_store',
      value: JSON.stringify(this.notes)
    });
  },

  startEdit() {
    this.vibrate('short');
    this.currentText = '';
    this.isEditing = true;
  },

  cancelEdit() {
    this.vibrate('short');
    this.isEditing = false;
  },

  addChar(char) {
    this.vibrate('short');
    this.currentText += char;
  },

  backspace() {
    this.vibrate('short');
    if (this.currentText.length > 0) {
      this.currentText = this.currentText.slice(0, -1);
    }
  },

  saveNote() {
    if (this.currentText.trim() !== '') {
      this.notes.push(this.currentText);
      this.persistData();
      this.vibrate('long');
    }
    this.isEditing = false;
  },

  deleteNote(index) {
    this.notes.splice(index, 1);
    this.persistData();
    this.vibrate('long');
  },

  vibrate(mode) {
    try { vibrator.vibrate({ mode: mode }); } catch(e) {}
  }
}
</script>

<style>
  /* ЧИСТЫЙ AMOLED PREMIUM ДИЗАЙН (Ширина 212px) */
  .container {
    flex-direction: column;
    background-color: #000000;
    width: 212px;
    height: 520px;
    align-items: center;
  }
  .page {
    flex-direction: column;
    width: 212px;
    height: 520px;
    padding: 16px 8px;
    align-items: center;
  }
  .header-row {
    flex-direction: row;
    width: 196px;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .title {
    color: #ffffff;
    font-size: 22px;
    font-weight: bold;
  }
  .count-badge {
    background-color: #3a3a3c;
    color: #ffffff;
    font-size: 13px;
    padding: 2px 8px;
    border-radius: 8px;
  }
  .notes-list {
    width: 196px;
    height: 380px;
    flex-direction: column;
  }
  .note-card {
    background-color: #1c1c1e;
    border-radius: 10px;
    margin-bottom: 8px;
    padding: 14px 12px;
    width: 196px;
  }
  .note-text {
    color: #ffffff;
    font-size: 16px;
  }
  .action-bar {
    width: 196px;
    height: 44px;
    margin-top: 8px;
  }
  .btn-primary {
    width: 196px;
    height: 44px;
    background-color: #ffffff;
    color: #000000;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
  }
  .btn-secondary {
    width: 196px;
    height: 36px;
    background-color: #1c1c1e;
    color: #ff453a;
    border-radius: 8px;
    font-size: 14px;
    margin-top: 8px;
  }
  .input-preview-box {
    width: 196px;
    height: 100px;
    background-color: #1c1c1e;
    border-radius: 10px;
    padding: 10px;
    margin-bottom: 10px;
  }
  .preview-text {
    color: #ffffff;
    font-size: 16px;
  }

  /* ИНЖЕНЕРНЫЙ БЛОК КЛАВИАТУРЫ */
  .keyboard-viewport {
    width: 196px;
    height: 280px;
    background-color: #151517;
    border-radius: 12px;
    padding: 6px;
    flex-direction: column;
  }
  
  /* Зона прокрутки всей телефонной платы */
  .keyboard-scroll-zone {
    width: 184px;
    height: 210px;
    flex-direction: row;
    overflow: scroll;
    scroll-x: true;
  }
  
  /* Монолитная телефонная раскладка в ширину */
  .qwerty-board {
    flex-direction: column;
    width: 720px; /* Растягиваем плату, чтобы буквы шли как на телефоне */
    height: 200px;
    justify-content: space-between;
  }
  .kbd-row {
    flex-direction: row;
    width: 720px;
  }
  .kbd-row-center {
    flex-direction: row;
    width: 720px;
    padding-left: 10px;
  }
  .kbd-row-bottom {
    flex-direction: row;
    width: 720px;
    padding-left: 20px;
  }
  
  /* Полноценная высокая телефонная клавиша */
  .key-cell {
    width: 38px;
    height: 60px;
    background-color: #2c2c2e;
    color: #ffffff;
    margin-right: 4px;
    border-radius: 6px;
    font-size: 20px;
    font-weight: bold;
    flex-shrink: 0;
  }

  /* Строгая нижняя панель управления */
  .keyboard-system-row {
    flex-direction: row;
    width: 184px;
    height: 50px;
    margin-top: 6px;
    justify-content: space-between;
  }
  .sys-btn {
    color: #ffffff;
    border-radius: 6px;
    font-weight: bold;
    font-size: 14px;
  }
  .btn-spacebar {
    width: 90px;
    height: 44px;
    background-color: #2c2c2e;
  }
  .btn-backspace {
    width: 42px;
    height: 44px;
    background-color: #3a3a3c;
    font-size: 16px;
  }
  .btn-submit {
    width: 44px;
    height: 44px;
    background-color: #ffffff;
    color: #000000;
  }
</style>
